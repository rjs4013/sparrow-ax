{
  "name": "sparrow-ax",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "node --test \"src/**/*.test.ts\"",
    "start": "node --env-file-if-exists=.env src/web/main.ts",
    "collect": "node --env-file=.env src/collect/main.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
