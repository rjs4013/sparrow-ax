# 복사해서 .env로 만들어 값을 채운다. .env는 커밋하지 않는다(.gitignore).
#
# 서비스별 서비스키. 공공데이터포털의 각 서비스 활용신청 화면에서 확인한다. 대화나 기록에 붙여 넣지 않는다.
# 포털은 Encoding 키와 Decoding 키를 따로 준다. 코드가 URL 인코딩을 하므로 Decoding(원문) 키를 넣는다.

# 나라장터 계약정보서비스 (경쟁사 계약 · 납품 수집)
G2B_CONTRACT_SERVICE_KEY=
G2B_CONTRACT_BASE_URL=

# 나라장터 공공데이터개방표준서비스 (입찰공고 · 낙찰)
G2B_OPENSTD_SERVICE_KEY=
G2B_OPENSTD_BASE_URL=

# 나라장터쇼핑몰 품목정보 서비스 (납품요구 · 실제 수요기관 확인용, WO-20261028-11)
# 요청주소 예: https://apis.data.go.kr/1230000/at/ShoppingMallPrdctInfoService (https만 허용된다)
G2B_SHOPPING_SERVICE_KEY=
G2B_SHOPPING_BASE_URL=

# 공공조달통계정보서비스. 건별 데이터가 아닌 집계 통계라 현재 사용하지 않는다(WO-20261028-05). 비워 둔다.
G2B_STATS_SERVICE_KEY=

# SQLite 파일 경로 (기본: data/sparrow.db)
DB_PATH=data/sparrow.db
# 웹 서버. 사내망 노출은 운영 환경이 정해진 뒤 HOST를 바꾼다.
HOST=127.0.0.1
PORT=3000
